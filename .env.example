# DownloadIn (KazamaDownloader) — salin ke .env lalu isi
PORT=3000
# WAJIB di production: string acak panjang untuk menandatangani link unduhan
# buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_KEY=
# Situs diakses lewat reverse proxy (Nginx/Cloudflare)? isi 1 supaya IP pengguna terbaca benar
TRUST_PROXY=0
# Path binary (kosongkan jika sudah ada di PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Batas
RATE_LIMIT=25          # permintaan /api/extract per menit per IP
MAX_JOBS=3             # proses yt-dlp download berjalan bersamaan
EXTRACT_TIMEOUT_MS=60000
# Opsional: proxy untuk situs yang memblokir IP datacenter (http://user:pass@host:port)
EXTRACT_PROXY=
