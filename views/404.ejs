<%- include('partials/head', { canonicalPath: '/' }) %>
<%- include('partials/header') %>
<main id="main" class="kazama-wrap kazama-notfound">
  <p class="kazama-notfound__code"><%= typeof error !== 'undefined' ? '500' : '404' %></p>
  <h1><%= typeof error !== 'undefined' ? 'Server sedang bermasalah' : 'Halaman tidak ditemukan' %></h1>
  <p class="kazama-lead">Link yang kamu buka tidak ada atau sudah dipindah. Kembali ke beranda dan tempel link videonya lagi.</p>
  <a class="kazama-btn kazama-btn--primary kazama-btn--large" href="/"><span>Ke beranda</span></a>
</main>
<%- include('partials/footer') %>
