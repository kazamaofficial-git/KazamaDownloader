<dialog id="history-dialog" aria-labelledby="history-title">
  <div class="dlg-head">
    <h2 id="history-title">Riwayat</h2>
    <button type="button" class="icon-btn" id="history-close" aria-label="Tutup"><svg class="ico"><use href="#i-x"/></svg></button>
  </div>
  <ul id="history-list" class="history-list"></ul>
  <button type="button" class="btn btn-pink btn-sm" id="history-clear"><svg class="ico"><use href="#i-trash"/></svg><span>Hapus semua</span></button>
</dialog>

<script type="application/json" id="catalog-data"><%- JSON.stringify(catalog).replace(/</g, '\\u003c') %></script>
<%- include('partials/footer') %>
