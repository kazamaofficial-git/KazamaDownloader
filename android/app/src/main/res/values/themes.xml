<resources>
    <style name="Theme.DownloadIn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dl_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DownloadIn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dl_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.DownloadIn</item>
    </style>
</resources>
